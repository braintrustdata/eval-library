# Braintrust API key (https://www.braintrust.dev/app/settings)
BRAINTRUST_API_KEY=

# Anthropic API key. Only needed if you are NOT signed in to the Claude Code CLI.
ANTHROPIC_API_KEY=

# OpenAI API key for the vector-search embeddings (optional).
# If unset, embeddings fall back to the Braintrust proxy using BRAINTRUST_API_KEY.
OPENAI_API_KEY=
